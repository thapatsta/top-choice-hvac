{
  "name": "top-choice-hvac",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Lead log — every form submission is written here by lib/notify.ts
  // (logLeadToKV). No "id" yet: `wrangler deploy` auto-provisions the
  // namespace on first deploy, and `wrangler dev` uses a local simulated
  // namespace. Once created, pin its id here — see README "Lead Delivery
  // Pipeline" → "Pinning the KV namespace id".
  "kv_namespaces": [{ "binding": "LEADS_KV" }],
  // Non-secret lead-pipeline config (secrets go through `wrangler secret put`
  // + deploy.yml). onboarding@resend.dev is Resend's shared test sender: it
  // only delivers to the Resend account owner's own address. Switch to an
  // address on a domain verified in Resend to send to any inbox.
  "vars": {
    "LEAD_FROM_EMAIL": "Top Choice HVAC Leads <onboarding@resend.dev>"
  }
}
