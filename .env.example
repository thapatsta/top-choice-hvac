# Lead Delivery Pipeline — see README "Lead Delivery Pipeline".
#
# Safe to commit: every value below is a deliberately fake REPLACE_ME
# placeholder. Never put a real value in this file.
#
# Local dev: copy to `.dev.vars` (gitignored) — both `wrangler dev` and
# `next dev` (via initOpenNextCloudflareForDev) read secrets from there.
# Production: `wrangler secret put <NAME>` + a matching GitHub Actions secret
# (deploy.yml uploads the GitHub secrets on every deploy).
#
# lib/notify.ts refuses to use any value starting with REPLACE_ME and logs a
# loud "[lead:<channel>:FAILED]" error instead; the KV lead log still works.

# Resend (email) — https://resend.com → API Keys
# TODO: real value required — see README Lead Delivery Pipeline section
RESEND_API_KEY=REPLACE_ME_RESEND_API_KEY_NOT_SET
# Inbox that receives every lead email.
# TODO: real value required — see README Lead Delivery Pipeline section
LEAD_NOTIFY_EMAIL=REPLACE_ME_DESTINATION_EMAIL_NOT_SET
# Sender address is not a secret — it's LEAD_FROM_EMAIL under "vars" in
# wrangler.jsonc.

# Twilio (SMS, emergency-service leads only) — https://console.twilio.com
# TODO: real value required — see README Lead Delivery Pipeline section
TWILIO_ACCOUNT_SID=REPLACE_ME_TWILIO_SID_NOT_SET
# TODO: real value required — see README Lead Delivery Pipeline section
TWILIO_AUTH_TOKEN=REPLACE_ME_TWILIO_AUTH_TOKEN_NOT_SET
# TODO: real value required — see README Lead Delivery Pipeline section
TWILIO_FROM_NUMBER=REPLACE_ME_TWILIO_FROM_NUMBER_NOT_SET
# Phone that receives emergency SMS alerts, E.164 format (+1XXXXXXXXXX).
# The real value is known — set it with `wrangler secret put`, not here.
LEAD_NOTIFY_PHONE=REPLACE_ME_E164_PHONE_SET_VIA_WRANGLER_SECRET

# --- Analytics (set real IDs in lib/site.ts, not here) ---
# See lib/site.ts: ga4Id, gtmId
